# --- AWS (short-lived; refresh immediately before each run) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- countyScansTitle SQL Server ---
# Windows auth (Trusted_Connection) is used when username is blank — just set the server.
# Leave username/password empty for Windows auth; fill them only for SQL Server auth.
cstitle_server=
cstitle_username=
cstitle_password=

# --- S3 ---
S3_BUCKET=enverus-courthouse-prod-chd-plants
AWS_REGION=us-east-1

# --- Processing tunables (optional) ---
MAX_FILE_MB=200   # files larger than this are failed (too big to convert/recover in memory)