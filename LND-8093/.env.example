# --- AWS (short-lived; refresh immediately before each run) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- countyScansTitle SQL Server ---
cstitle_server=
cstitle_username=
cstitle_password=

# --- S3 ---
S3_BUCKET=enverus-courthouse-prod-chd-plants
AWS_REGION=us-east-1

# --- Processing tunables (all optional) ---
MAX_WORKERS=8
STATE=ALL            # e.g. TX to scope a run to one state; ALL = no filter
ROW_LIMIT=           # e.g. 500000 to window a large state; blank = all pending
ALLOW_FULL_SCAN=false # must be true to run STATE=ALL with no ROW_LIMIT (~9M rows; high memory + one big SELECT INTO)
WARN_WORK_THRESHOLD=1000000 # log a high-memory warning when a run loads more than this many records
CHUNK_SIZE=2000      # files per worker task; smaller = better load balancing, more CSVs
BATCH_TIMEOUT=1800   # per-chunk wall-clock seconds before the worker is killed (hung-share guard)
MAX_BUFFER_MB=100    # PDFs <= this are read once into memory (page count + upload share the buffer); larger stream
VERIFY_UPLOADS=false # true = HEAD each object after upload (doubles S3 calls; forces the streaming path)
FINALIZE_BATCH_SIZE=1000